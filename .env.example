# ========================================================
# 智能客服系统模型与环境配置文件示例
# 复制本文件为 .env 并填入您自己的真实 API Key 即可启动
# ========================================================

# 1. 对话生成与 Query 改写 (接入 DeepSeek 官方 API 或 OpenAI 兼容大模型)
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 2. 文本向量化 Embedding (接入 硅基流动 SiliconFlow 顶级中文向量模型，1024维)
EMBEDDING_API_KEY=your_siliconflow_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# 3. 语义重排 Rerank (接入 硅基流动 SiliconFlow Cross-Encoder 模型)
RERANK_API_KEY=your_siliconflow_api_key_here
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 4. 数据库配置 (默认本地轻量 SQLite，可无缝切至 PostgreSQL pgvector)
DATABASE_URL=sqlite+aiosqlite:///./knowledge_base.db
